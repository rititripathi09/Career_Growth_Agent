# Copy this file to .streamlit/secrets.toml and fill in your free keys.
# secrets.toml is git-ignored: never commit real keys.

# Primary model provider: gemini | groq | ollama
LLM_PROVIDER = "gemini"
# Used automatically if the primary fails (e.g. daily free quota reached)
LLM_FALLBACK = "groq"
# Optional: override the model name (check Google AI Studio for the current free Flash model)
# LLM_MODEL = "gemini-flash-latest"

# Free key from https://aistudio.google.com (no card needed)
GEMINI_API_KEY = ""
# Free key from https://console.groq.com
GROQ_API_KEY = ""
# Optional: raises GitHub API limit from 60 to 5,000 requests/hour
# GITHUB_TOKEN = ""
